{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      // Paste output of `information-guard-sandbox --print-claude-config` here
      // (the permissions.deny entries). Generated from your sandbox.json:
      //   protectedPaths          → Read + Edit deny
      //   READ_PROTECTED_CREDENTIALS → Read + Edit deny (~/.ssh, ~/.aws, ...)
      //   WRITE_PROTECTED_DOTFILES  → Edit deny only (~/.zshrc, ~/.local/bin, ...)
      // Regenerate after changing sandbox.json.

      // General hardening (not generated by information-guard).
      // Dangerous commands and secrets patterns — recommended baseline.

      // Destructive / system commands
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(chmod 000:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(*>/etc/passwd:*)",
      "Bash(*>/etc/shadow:*)",
      "Bash(*>/etc/sudoers:*)",
      "Bash(kill -9 1:*)",
      "Bash(killall -9 init:*)",
      "Bash(killall -9 systemd:*)",
      "Bash(setenforce 0:*)",
      "Bash(iptables -F:*)",
      "Bash(ufw disable:*)",
      "Bash(chmod +s:*)",
      "Bash(chmod u+s:*)",
      "Bash(docker run --privileged:*)",

      // Secrets — block reading common secret file patterns
      "Read(**/secrets/**)",
      "Read(**/*password*)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.env)",
      "Read(**/.env.*)",

      // Secrets — block reading .env files via Bash
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env)",
      "Bash(head *.env.*)",
      "Bash(head *.env*)",
      "Bash(tail *.env)",
      "Bash(tail *.env.*)",
      "Bash(tail *.env*)",
      "Bash(less *.env)",
      "Bash(less *.env*)",
      "Bash(more *.env)",
      "Bash(more *.env*)",
      "Bash(xxd *.env*)",
      "Bash(od *.env*)",
      "Bash(strings *.env*)"
    ],
    "ask": [
      // Consequential operations — confirm before running
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git reset --hard:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)"
    ]
  },
  // Sandbox — also from `--print-claude-config` (the "sandbox" object).
  // Enable write containment; allowWrite lists extra dirs the Bash tool may
  // write (workspace/cwd is always allowed). Mirrors writeContainment in
  // sandbox.json — regenerate after changing it.
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": []
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'export AGENT_FLAG=claude' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  }
}
